{
  "$schema": "https://schema.tauri.app/config/2",
  "productName": "Tandem",
  "version": "0.3.3",
  "identifier": "com.franc1sc0sv.tandem",
  "build": {
    "beforeDevCommand": "pnpm dev",
    "devUrl": "http://localhost:1420",
    "beforeBuildCommand": "pnpm build",
    "frontendDist": "../dist"
  },
  "app": {
    "windows": [
      {
        "label": "main",
        "title": "Tandem",
        "width": 1280,
        "height": 860,
        "minWidth": 720,
        "minHeight": 480,
        "backgroundColor": "#0e0f12"
      },
      {
        "label": "tray",
        "url": "tray.html",
        "title": "Tandem",
        "width": 380,
        "height": 600,
        "visible": false,
        "decorations": false,
        "resizable": false,
        "alwaysOnTop": true,
        "skipTaskbar": true,
        "focus": true,
        "backgroundColor": "#0e0f12"
      }
    ],
    "security": {
      "csp": "default-src 'self'; style-src 'self' 'unsafe-inline'; img-src 'self' data:"
    }
  },
  "bundle": {
    "active": true,
    "targets": "all",
    "icon": [
      "icons/32x32.png",
      "icons/128x128.png",
      "icons/128x128@2x.png",
      "icons/icon.icns",
      "icons/icon.ico"
    ]
  },
  "plugins": {
    "updater": {
      "pubkey": "dW50cnVzdGVkIGNvbW1lbnQ6IG1pbmlzaWduIHB1YmxpYyBrZXk6IEI0MjQ2QjY3OUJBQkVGN0MKUldSODc2dWJaMnNrdEsrUVVTbWxZRWl6UUdVVjdZMEVkYng2N0QvOXVXajFoNnVmM1VKSVhFZVAK",
      "endpoints": ["https://github.com/franc1sc0sv/tandem/releases/latest/download/latest.json"],
      "windows": {
        "installMode": "passive"
      }
    }
  }
}
