{
  "name": "tandem-ui",
  "private": true,
  "version": "0.3.2",
  "type": "module",
  "scripts": {
    "dev": "vite",
    "build": "vite build",
    "build:demo": "vite build --mode demo --outDir dist-demo",
    "check": "svelte-check --tsconfig ./tsconfig.json --fail-on-warnings",
    "check:scripts": "tsc --noEmit -p scripts/tsconfig.json",
    "test": "vitest run",
    "shots": "node scripts/shots.ts",
    "tauri": "tauri"
  },
  "packageManager": "pnpm@10.32.1",
  "engines": {
    "node": ">=22.18"
  },
  "devDependencies": {
    "@sveltejs/vite-plugin-svelte": "6.2.4",
    "@tandem/mockup-render": "link:../../tools/mockup-render",
    "@tauri-apps/cli": "2.12.3",
    "@testing-library/jest-dom": "6.9.1",
    "@testing-library/svelte": "5.4.2",
    "@testing-library/user-event": "14.6.12",
    "@tsconfig/svelte": "5.0.9",
    "@types/node": "22.20.5",
    "@types/pngjs": "6.0.5",
    "fast-check": "4.10.3",
    "jsdom": "27.4.0",
    "playwright": "1.65.1",
    "pngjs": "7.0.0",
    "svelte": "5.57.3",
    "svelte-check": "4.7.8",
    "typescript": "5.9.3",
    "vite": "7.3.7",
    "vitest": "4.1.12"
  },
  "dependencies": {
    "@fontsource/dejavu-sans": "5.3.0",
    "@fontsource/inter": "5.3.0",
    "@fontsource/jetbrains-mono": "5.3.0",
    "@tauri-apps/api": "2.12.4",
    "@xterm/addon-fit": "0.10.0",
    "@xterm/xterm": "5.5.0"
  },
  "pnpm": {
    "onlyBuiltDependencies": [
      "esbuild"
    ]
  }
}
